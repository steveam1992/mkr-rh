{
  "name": "mkr-rh",
  "version": "1.0.0",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "start": "electron-vite dev",
    "package": "electron-vite build && electron-builder --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Sistema de gestion de recursos humanos",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0"
  },
  "dependencies": {
    "vue": "^3.5.35",
    "vue-router": "^5.1.0",
    "vuex": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.mkr.rh",
    "productName": "MKR RH",
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "executableName": "mkr-rh",
      "maintainer": "MKR Solutions <samdub92@gmail.com>"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "directories": {
      "output": "dist"
    },
    "afterPack": "build/adhoc-sign.js"
  }
}
